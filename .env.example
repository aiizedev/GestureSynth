# Supabase — autenticacion con Google (OPCIONAL).
#
# Crear y tocar sonidos NO necesita cuenta. La cuenta solo sirve para guardar
# los presets en la nube y usarlos en cualquier dispositivo.
#
# Copia este archivo a `.env.local` (ignorado por git) con los valores reales,
# o define estas variables en Vercel (Production + Preview + Development) y
# vuelve a desplegar (Vite inyecta VITE_* en tiempo de build).

VITE_SUPABASE_URL=https://rhnroqqeqowhnurfxwfg.supabase.co

# NOTA: el nombre termina en _ANON_KEY por convencion/compatibilidad, pero el
# valor es la CLAVE PUBLICABLE moderna (sb_publishable_...), segura en el cliente.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
