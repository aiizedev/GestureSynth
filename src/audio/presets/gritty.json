{
  "version": 2,
  "engine": "subtractive",
  "oscillator": { "waveform": "square", "unison": 1, "spread": 14 },
  "filter": { "cutoff": 1200, "resonance": 6, "rolloff": -24, "envAmount": 3.5 },
  "filterEnv": { "attack": 0.005, "decay": 0.2, "sustain": 0.3, "release": 0.25 },
  "ampEnv": { "attack": 0.005, "decay": 0.15, "sustain": 0.6, "release": 0.25 },
  "drive": 0.6,
  "fx": {
    "chorus": 0.1,
    "delay": { "wet": 0.12, "time": "8n.", "feedback": 0.35 },
    "reverb": { "wet": 0.15, "decay": 1.6 }
  },
  "glide": 0,
  "master": -6
}
