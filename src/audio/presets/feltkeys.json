{
  "version": 2,
  "engine": "subtractive",
  "oscillator": { "waveform": "triangle", "unison": 1, "spread": 8 },
  "filter": { "cutoff": 1500, "resonance": 1.0, "rolloff": -24, "envAmount": 1.2 },
  "filterEnv": { "attack": 0.008, "decay": 0.8, "sustain": 0.15, "release": 0.6 },
  "ampEnv": { "attack": 0.015, "decay": 1.2, "sustain": 0.35, "release": 2.0 },
