{
  "version": 2,
  "engine": "subtractive",
  "oscillator": { "waveform": "triangle", "unison": 1, "spread": 10 },
  "filter": { "cutoff": 1100, "resonance": 1.5, "rolloff": -24, "envAmount": 2.2 },
  "filterEnv": { "attack": 0.008, "decay": 0.8, "sustain": 0, "release": 0.6 },
  "ampEnv": { "attack": 0.015, "decay": 1.1, "sustain": 0.25, "release": 1.8 },
  "drive": 0.05,
  "fx": {
    "chorus": 0.15,
    "delay": { "wet": 0.1, "time": "8n", "feedback": 0.2 },
    "reverb": { "wet": 0.7, "decay": 5.0 }
  },
  "glide": 0,
  "master": -6
}
